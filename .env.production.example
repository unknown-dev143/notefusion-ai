# ============================================================
# NoteFusion AI — Production Environment Template
# Copy this to .env on your VPS and fill in real values.
# NEVER commit the real .env file to Git.
# ============================================================

# ----- Application -----
APP_NAME=NoteFusion AI
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
CSRF_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING

# ----- Domain (update once you have your domain/IP) -----
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com/api/v1
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ----- Database (PostgreSQL) -----
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=notefusion
POSTGRES_USER=notefusion_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://notefusion_user:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/notefusion

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ----- OpenAI -----
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/auth/google/callback

# ----- Stripe -----
STRIPE_PUBLIC_KEY=pk_live_REPLACE_WITH_STRIPE_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# ----- Email (SMTP) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
EMAIL_FROM=noreply@yourdomain.com

# ----- Monitoring -----
GRAFANA_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD
SENTRY_DSN=https://REPLACE_WITH_SENTRY_DSN@sentry.io/PROJECT_ID

# ----- Security -----
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=60
