# Production Environment Variables for NoteFusion AI
# Copy this to .env and update values before deploying

# Database
POSTGRES_PASSWORD=notefusion123
DATABASE_URL=postgresql+asyncpg://notefusion:notefusion123@db:5432/notefusion

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production-32chars
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-32chars

# Application
ENV=production
DEBUG=false
RAILWAY_ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (Update with your domain)
ALLOWED_ORIGINS=https://yourdomain.com
CORS_ORIGINS=["https://yourdomain.com", "http://localhost:3000", "http://localhost:80"]

# Redis
REDIS_URL=redis://redis:6379

# OpenAI (Required for AI features)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Monitoring
PROMETHEUS_ENABLED=false
