# NoteFusion AI - Frontend Environment Template
# Variables prefixed with VITE_ are exposed to the browser

# Application
VITE_APP_NAME=NoteFusion AI
VITE_APP_ENV=development
VITE_DEBUG=true

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=notefusion-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=notefusion-ai
VITE_FIREBASE_STORAGE_BUCKET=notefusion-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# External Services
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_API_KEY=your-google-api-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
VITE_LEMON_SQUEEZY_VARIANT_ID=your-variant-id

# Support & Legal
VITE_SUPPORT_EMAIL=support@notefusion.ai
VITE_TERMS_URL=https://notefusion.ai/terms
VITE_PRIVACY_URL=https://notefusion.ai/privacy

# Feature Flags
VITE_ENABLE_MOCKS=false
VITE_ENABLE_EXPERIMENTAL_FEATURES=false
