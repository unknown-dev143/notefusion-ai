# ============================================================
# NoteFusion AI — Frontend Production Environment
# This file is committed — it only contains non-secret config.
# The actual Render URL will be set after backend is deployed.
# ============================================================

# Backend URL — replace with your Render backend URL after deploy
# e.g. https://notefusion-backend.onrender.com
VITE_API_URL=https://notefusion-backend.onrender.com/api/v1
VITE_WS_URL=wss://notefusion-backend.onrender.com/ws

# App name
VITE_APP_NAME=NoteFusion AI
VITE_APP_VERSION=2.0.0

# Stripe publishable key (safe to expose — it's public)
VITE_STRIPE_PUBLIC_KEY=pk_test_replace_with_your_stripe_public_key
