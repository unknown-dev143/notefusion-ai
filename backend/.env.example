# Application
APP_NAME="NoteFusion"
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./notefusion.db

# Security
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# OpenAI (if needed)
# OPENAI_API_KEY=your-openai-api-key
